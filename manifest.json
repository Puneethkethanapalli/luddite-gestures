{
  "schemaVersion": 1,
  "id": "io.github.techluddite.gestures",
  "name": "Luddite Gestures",
  "version": "0.2.0",
  "author": "TechLuddite",
  "license": "MIT",
  "description": "A panel for editing Hyprland touchpad gestures. Writes a managed block into ~/.config/hypr/input.lua, shows the gestures you wrote by hand alongside it, and flags shadowed swipes before you save.",
  "homepage": "https://github.com/TechLuddite/luddite-gestures",
  "repository": "https://github.com/TechLuddite/luddite-gestures",
  "kinds": [
    "panel",
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "panel": "Panel.qml",
    "service": "Service.qml",
    "barWidget": "BarIcon.qml"
  },
  "barWidget": {
    "displayName": "Luddite Gestures",
    "description": "Opens the touchpad gesture editor.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
